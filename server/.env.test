# Test environment: points at the local Docker test database only.
# Safe to commit - these credentials exist only inside the throwaway container.
NODE_ENV=test
DATABASE_URL=postgresql://bookit:bookit_test@localhost:5434/bookit_test
JWT_ACCESS_SECRET=test-access-secret-0123456789
JWT_ACCESS_EXPIRES_IN=15m
EMAIL_USER=
EMAIL_PASS=
# High limits so suites that log in often are not throttled (rateLimit.test.ts sets its own).
RATE_LIMIT_MAX=100000
AUTH_RATE_LIMIT_MAX=100000
UPLOADS_DIR=uploads-test
# Payments are simulated in tests.
PAYMENT_GATEWAY=fake
